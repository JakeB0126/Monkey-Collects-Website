generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProductCategory {
  pokemon_tcg
  merch
}

enum ProductStatus {
  active
  draft
  sold_out
  hidden
}

enum OrderStatus {
  pending
  canceled
  fulfilled
}

enum PaymentStatus {
  unpaid
  paid
  failed
  refunded
}

model Product {
  id            String          @id @default(cuid())
  slug          String          @unique
  name          String
  description   String
  category      ProductCategory
  productType   String
  priceCents    Int
  stockQuantity Int
  status        ProductStatus   @default(draft)
  images        String[]
  featured      Boolean         @default(false)
  orderItems    OrderItem[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([category, status])
  @@index([featured, status])
}

model Order {
  id            String        @id @default(cuid())
  customerEmail String?
  status        OrderStatus   @default(pending)
  paymentStatus PaymentStatus @default(unpaid)
  subtotalCents Int
  totalCents    Int
  items         OrderItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  productId      String
  quantity       Int
  unitPriceCents Int
  lineTotalCents Int
  productName    String
  productSlug    String
  productImage   String?
  createdAt      DateTime @default(now())
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}
